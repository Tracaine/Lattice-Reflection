{
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "ESNext.Array",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "../packages/**/*.ts",
    "../tests/**/*.ts",
    "../apps/**/*.ts",
    "../apps/**/*.tsx",
    "../packages/**/*.tsx"
  ]
}
