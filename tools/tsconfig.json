{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Array"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["../packages/**/*.ts", "../tests/**/*.ts"]
}
